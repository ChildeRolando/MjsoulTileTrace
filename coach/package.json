{
  "name": "riichi-coach",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build -w @riichi-coach/contracts && npm run build -w @riichi-coach/mahjong-soul-source && npm run build -w @riichi-coach/tenhou-source && npm run build -w @riichi-coach/mortal-source && npm run build -w @riichi-coach/reasoning && npm run build -w @riichi-coach/desktop",
    "test": "npm run build && vitest run && npm run test:mahjong-soul-protocol-updater && npm run test:mahjong-soul-protocol-compatibility && npm run test:generate-mahjong-soul-real-fixtures",
    "test:mahjong-soul-protocol-updater": "node --test scripts/update-mahjong-soul-protocol.test.mjs",
    "test:mahjong-soul-protocol-compatibility": "node --test scripts/mahjong-soul-protocol-compatibility.test.mjs",
    "test:generate-mahjong-soul-real-fixtures": "node --test scripts/generate-mahjong-soul-real-fixtures.test.mjs",
    "test:desktop": "vitest run packages/desktop/tests",
    "build:fact-engine": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-fact-engine.ps1",
    "package:fact-engine": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-fact-engine.ps1",
    "generate:factor-regression-golden": "node scripts/generate-factor-regression-golden.mjs",
    "test:fact-engine": "cd tools/mahjong-facts && go test ./...",
    "test:package-import": "npm run build && node --test smoke/package-import-smoke.mjs",
    "coach": "npm run build && node bin/riichi-coach.mjs",
    "coach:demo": "npm run coach",
    "desktop": "npm run build && electron packages/desktop/dist/electron-entry.js",
    "desktop:diagnose-mahjong-soul-restore": "npm run build && electron packages/desktop/dist/electron-entry.js --diagnose-mahjong-soul-restore",
    "desktop:diagnose-mahjong-soul-replay": "npm run build && electron packages/desktop/dist/electron-entry.js --diagnose-mahjong-soul-replay",
    "desktop:diagnose-mahjong-soul-capture-record": "npm run build && electron packages/desktop/dist/electron-entry.js --diagnose-mahjong-soul-capture-record",
    "desktop:diagnose-mortal-decision": "npm run build && electron packages/desktop/dist/electron-entry.js --diagnose-mortal-decision",
    "desktop:diagnose-mortal-full-game": "npm run build && electron packages/desktop/dist/electron-entry.js --diagnose-mortal-full-game",
    "typecheck": "tsc --noEmit -p packages/contracts/tsconfig.json && tsc --noEmit -p packages/mahjong-soul-source/tsconfig.json && tsc --noEmit -p packages/tenhou-source/tsconfig.json && tsc --noEmit -p packages/mortal-source/tsconfig.json && tsc --noEmit -p packages/reasoning/tsconfig.json && tsc --noEmit -p packages/desktop/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "protobufjs": "8.7.2",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  }
}
