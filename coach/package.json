{
  "name": "riichi-coach",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @riichi-coach/contracts && npm run build -w @riichi-coach/mahjong-soul-source && npm run build -w @riichi-coach/tenhou-source && npm run build -w @riichi-coach/mortal-source && npm run build -w @riichi-coach/mortal-runtime && npm run build -w @riichi-coach/reasoning && npm run build -w @riichi-coach/question-lab && npm run build -w @riichi-coach/desktop",
    "test": "npm run build && vitest run && npm run test:mahjong-soul-protocol-updater && npm run test:mahjong-soul-protocol-compatibility && npm run test:generate-mahjong-soul-real-fixtures && npm run check:architecture",
    "test:mahjong-soul-protocol-updater": "node --test scripts/update-mahjong-soul-protocol.test.mjs",
    "test:mahjong-soul-protocol-compatibility": "node --test scripts/mahjong-soul-protocol-compatibility.test.mjs",
    "test:generate-mahjong-soul-real-fixtures": "node --test scripts/generate-mahjong-soul-real-fixtures.test.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test:architecture-checker": "node --test scripts/check-architecture.test.mjs",
    "test:golden": "npm run build && vitest run packages/reasoning/tests/golden-vertical-slice.test.ts",
    "test:desktop": "vitest run packages/desktop/tests",
    "test:electron-persistence": "npm run build -w @riichi-coach/desktop && electron packages/desktop/tests/electron-persistence-smoke.cjs",
    "test:package-persistence-scale": "node packages/desktop/tests/package-persistence-scale.mjs",
    "prepare:review-cache": "node packages/desktop/scripts/prepare-review-cache.mjs",
    "build:fact-engine": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-fact-engine.ps1",
    "package:fact-engine": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-fact-engine.ps1",
    "generate:factor-regression-golden": "node scripts/generate-factor-regression-golden.mjs",
    "test:fact-engine": "cd tools/mahjong-facts && go test ./...",
    "test:fact-engine-reproducibility": "node --test scripts/fact-engine-reproducibility.mjs",
    "test:package-import": "npm run build && node --test smoke/package-import-smoke.mjs",
    "arena": "npm run build && node bin/blind-discard-arena.mjs",
    "arena:console": "npm run build && node bin/blind-discard-arena-console.mjs",
    "scene-study": "node bin/scene-pattern-study.mjs",
    "context-rag": "node bin/arena-context-rag.mjs",
    "test:context-rag": "vitest run packages/desktop/tests/arena-rag-components.test.ts packages/desktop/tests/blind-discard-arena-rag.test.ts packages/desktop/tests/blind-discard-arena-runner.test.ts scripts/context-rag --no-file-parallelism",
    "test:scene-study": "vitest run packages/reasoning/tests/scene-patterns.test.ts packages/desktop/tests/scene-study-facts.test.ts packages/desktop/tests/scene-study-runner.test.ts scripts/scene-study --no-file-parallelism",
    "test:arena-archive": "npm run build -w @riichi-coach/desktop && vitest run packages/desktop/tests/blind-discard-arena-archive.test.ts",
    "coach": "npm run build && node bin/riichi-coach.mjs",
    "coach:demo": "npm run coach",
    "desktop": "npm run build && electron packages/desktop/dist/electron-entry.js",
    "desktop:diagnose-mahjong-soul-restore": "npm run build && electron packages/desktop/dist/electron-entry.js --diagnose-mahjong-soul-restore",
    "desktop:diagnose-mahjong-soul-replay": "npm run build && electron packages/desktop/dist/electron-entry.js --diagnose-mahjong-soul-replay",
    "desktop:diagnose-mahjong-soul-capture-record": "npm run build && electron packages/desktop/dist/electron-entry.js --diagnose-mahjong-soul-capture-record",
    "desktop:diagnose-mortal-decision": "npm run build && electron packages/desktop/dist/electron-entry.js --diagnose-mortal-decision",
    "desktop:diagnose-mortal-full-game": "npm run build && electron packages/desktop/dist/electron-entry.js --diagnose-mortal-full-game",
    "prepare:local-mortal-spike": "node scripts/prepare-local-mortal-spike.mjs",
    "test:local-mortal-production-spike": "node --max-old-space-size=8192 scripts/local-mortal-production-spike.mjs",
    "typecheck": "tsc --noEmit -p packages/contracts/tsconfig.json && tsc --noEmit -p packages/mahjong-soul-source/tsconfig.json && tsc --noEmit -p packages/tenhou-source/tsconfig.json && tsc --noEmit -p packages/mortal-source/tsconfig.json && tsc --noEmit -p packages/mortal-runtime/tsconfig.json && tsc --noEmit -p packages/reasoning/tsconfig.json && tsc --noEmit -p packages/question-lab/tsconfig.json && tsc --noEmit -p packages/desktop/tsconfig.json",
    "test:electron-mvp-golden": "npm run build && node packages/desktop/tests/electron-mvp-golden-slice.cjs",
    "question-lab": "node packages/question-lab/dist/cli.js",
    "test:question-lab": "vitest run packages/question-lab/tests packages/contracts/tests/question-lab.test.ts",
    "corpus": "node --use-env-proxy bin/replay-corpus.mjs",
    "test:corpus": "node --test scripts/replay-corpus/corpus.test.mjs",
    "bench:corpus": "node scripts/replay-corpus/benchmark.mjs",
    "mortal-ablation": "node bin/arena-mortal-ablation.mjs",
    "scene-ceiling": "node bin/scene-pattern-ceiling.mjs",
    "test:scene-ceiling": "vitest run scripts/mortal-ablation/ceiling.test.mjs packages/desktop/tests/blind-discard-arena-case.test.ts packages/desktop/tests/blind-discard-arena-scorer.test.ts --no-file-parallelism",
    "test:mortal-ablation": "vitest run packages/desktop/tests/mortal-ablation-experiment.test.mjs packages/desktop/tests/mortal-ablation-report.test.mjs packages/desktop/tests/blind-discard-arena-scorer.test.ts packages/desktop/tests/blind-discard-arena-runner.test.ts --no-file-parallelism",
    "textbook:mcp": "node bin/textbook-mcp-server.mjs",
    "textbook:prepare": "node scripts/scene-study/compile-textbook-corpus.mjs",
    "test:textbook-mcp": "vitest run packages/desktop/tests/textbook-knowledge.test.ts packages/desktop/tests/textbook-mcp.test.ts --no-file-parallelism"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "hyparquet": "1.31.5",
    "hyparquet-compressors": "1.1.2",
    "protobufjs": "8.7.2",
    "tar-stream": "3.2.2",
    "typescript": "5.9.2",
    "vitest": "3.2.7",
    "yauzl": "3.4.0"
  }
}
