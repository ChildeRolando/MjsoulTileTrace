{
  "name": "riichi-coach",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build -w @riichi-coach/contracts && npm run build -w @riichi-coach/reasoning",
    "test": "npm run build && vitest run",
    "test:package-import": "npm run build && node --test smoke/package-import-smoke.mjs",
    "typecheck": "tsc --noEmit -p packages/contracts/tsconfig.json && tsc --noEmit -p packages/reasoning/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  }
}
