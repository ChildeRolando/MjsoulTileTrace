        {
          "text": " ",
          "marks": [],
          "href": null
        },
        {
          "text": "这些都要根据自己的点数情况来进行判断。",
          "marks": [],
          "href": null
        },
        {
          "text": " ",
          "marks": [],
          "href": null
        },
        {
          "text": " ",
          "marks": [],
          "href": null
        },
        {
          "text": "“能兜牌”的状况是不确定的。",
          "marks": [],
          "href": null
        },
        {
          "text": " ",
          "marks": [],
          "href": null
        },
        {
          "text": " ",
          "marks": [],
          "href": null
        },
        {
          "text": "不要忘了防守的基本是“弃和”。",
          "marks": [],
          "href": null
        },
        {
          "text": " ",
          "marks": [],
          "href": null
        },
        {
          "text": " ",
          "marks": [],
          "href": null
        },
        {
          "text": " ",
          "marks": [],
          "href": null
        },
        {
          "text": " ",
          "marks": [],
          "href": null
        },
        {
          "text": " ",
          "marks": [],
          "href": null
        },
        {
          "text": "（待续）",
          "marks": [],
          "href": null
        }
      ]
    }
