        "tableContext": null
      },
      {
        "type": "text",
        "sourceBlockIds": [
          "79-bilibili-cn:cv1785770:b0036"
        ],
        "sourceText": "一发中里宝或者自摸中1里宝就能够逆转的状况的话，即立是正确的。",
        "text": "一发中里宝或者自摸中1里宝就能够逆转的状况的话，即立是正确的。",
