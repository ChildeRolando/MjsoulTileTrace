  "modelReview": {
    "translation": {
      "targetId": "79-bilibili-cn:cv1760573:b0003",
      "verdict": "faithful",
      "evidence": "“立直舍内，发展舍外”准确而简练地表达了格言：立直时舍内侧牌，继续发展牌形时舍外侧牌。上下文以124索摸5索及例1的切牌选择说明内外所指，释义充分，保留了口诀语气。日文及旧中文括注均保留；后文效果有限、4索危险时可切1索的条件也未被删除，不能把口诀读成无条件规则。"
    },
    "carriedIssue": {
      "targetId": "79-bilibili-cn:cv1760573:b0013",
      "positionConfirmed": true,
      "currentDisplayFaithful": true,
      "authorArgumentFaithfulWithCurrentLimitation": true,
      "requiresResolvedMeaningOrExactTileForAuthorArgument": false,
      "evidence": "该块位于末尾position 12，承接b0011的低信息量舍牌说明及b0012的舍牌示例。候选如实保留“这样的立直话，对手只能对日”，但复制准确不等于语义已解。无法确定的只是该句所指的具体对手应对行为；作者明确写出的少暴露信息、偏好无特征舍牌，以及“强大的河”相比迷彩更容易荣和的主张仍可展示。允许仅限于实际附带下列审校限制，不表示当前正文已经包含这些说明。",
      "requiredDisplayLimitations": [
        "须在该句邻近实际展示并标明为非原文审校注：“源文‘这样的立直话，对手只能对日’语义不明，现照录；不能据此确定对手只能采取何种行动。”",
        "不得补写、翻译性改写或讲解“对日”为任何确定战术行为，也不得把“只能”扩展成已确认的对手行动限制。",
        "后文“强大的河”更容易荣和须作为作者明确提出的主张展示，不得声称歧义句已经证明其机制、概率或最优性。",
        "本次有限允许不认证精确牌谱、隐藏手牌、所有对手的安全度、概率或最优打法。"
      ],
      "unresolvedContributionOrMinimumGap": "尚未确认的是“对手只能对日”这一局部句子具体断言了什么应对行为。展示其他明确论述无需先解决它；若要完整解释或引用该局部命题，最小补证是能明确其谓语及所指行为的可靠校勘原句，不能靠猜牌或推测意图补足。"
    },
    "argumentChecks": [
      {
        "sourceBlockIds": [
          "79-bilibili-cn:cv1760573:b0003",
          "79-bilibili-cn:cv1760573:b0004",
          "79-bilibili-cn:cv1760573:b0005"
        ],
        "authorContribution": "区分发展牌形与立直时的切牌取向，并用例1说明立直时倾向舍内侧牌。",
        "preservedConditions": "124索摸5索时，从两面发展角度切1索；例1要立直时推荐切4索。场上已有现物4索时，3索可能更容易被打出，但效果有限；4索非常危险时也可切1索立直。",
        "faithfulWithCurrentLimitation": true,
        "evidence": "新释义与这些条件一致，未将格言改成绝对命令；末段源歧义不影响此处论述。"
      },
      {
        "sourceBlockIds": [
          "79-bilibili-cn:cv1760573:b0006",
          "79-bilibili-cn:cv1760573:b0007"
        ],
        "authorContribution": "例2比较切2饼与切3饼的立直选择，提出无平和时优先保留暗刻。",
        "preservedConditions": "两种切法均可立直；建议针对“像这样没有平和的牌”。保留暗刻后摸1饼可暗杠，作者列出的收益是增加符数及可能增加宝牌。",
        "faithfulWithCurrentLimitation": true,
        "evidence": "条件、可能性措辞及图文承接均保留，不受“对日”歧义影响；无需另补作者未写出的战术证明。"
      },
      {
        "sourceBlockIds": [
          "79-bilibili-cn:cv1760573:b0007"
        ],
        "authorContribution": "提出“情报要少”，评价过去的迷彩战术，并主张舍牌越没有特征越好。",
        "preservedConditions": "迷彩在原文中解释为在舍牌中设陷阱；对迷彩的否定及对无特征舍牌的偏好均作为作者观点保留。",
        "faithfulWithCurrentLimitation": true,
        "evidence": "这是作者直接写明的原则，不依赖末尾不明句才能辨认其主张。"
      },
      {
        "sourceBlockIds": [
          "79-bilibili-cn:cv1760573:b0008",
          "79-bilibili-cn:cv1760573:b0009",
          "79-bilibili-cn:cv1760573:b0010",
          "79-bilibili-cn:cv1760573:b0011"
        ],
        "authorContribution": "例3建议用4饼替换北雀头、切北，以减少立直后泄露的信息。",
        "preservedConditions": "切4饼的分支承接b0010所列1、2、3、4、7饼，作者称他家会容易切出这些牌；切北分支保留“他家也只能知道你不是单骑听牌”的原有说法。",
        "faithfulWithCurrentLimitation": true,
        "evidence": "文字被中间牌图接续的顺序完整保留，可辨认两个分支及其信息差异；此判断不额外认证这些牌对所有对手的安全度。"
      },
      {
        "sourceBlockIds": [
          "79-bilibili-cn:cv1760573:b0011",
