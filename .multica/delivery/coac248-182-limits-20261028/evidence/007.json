    {
      "id": "79-bilibili-cn:cv1760573:b0003",
      "paragraphId": "79-bilibili-cn:cv1760573:p0003",
      "tag": "p",
      "domPath": "main/p[2]",
      "tableContext": null,
      "type": "text",
      "text": "原文地址：http://beginners.biz/reach/reach06.html ------------------------------------------------------------------------------------ 立直理论2：  ------------------------------------------------------------------------------------ かけるは内、のばすは外（太专业了= =，没想好怎么翻） ------------------------------------------------------------------------------------  比如124索这样的形， 摸到5索，从两面的角度考虑切掉1索是理所当然的打法。 但是，要立直的话就不一样了。 ",
      "segments": [
        {
          "text": "原文地址：http://beginners.biz/reach/reach06.html",
          "marks": [],
          "href": null
        },
        {
          "text": " ",
          "marks": [],
          "href": null
        },
        {
          "text": "------------------------------------------------------------------------------------",
          "marks": [],
          "href": null
        },
        {
          "text": " ",
          "marks": [],
          "href": null
        },
        {
          "text": "立直理论2：",
          "marks": [],
          "href": null
        },
        {
          "text": " ",
          "marks": [],
          "href": null
        },
        {
          "text": " ",
          "marks": [],
          "href": null
        },
        {
          "text": "------------------------------------------------------------------------------------",
          "marks": [],
          "href": null
        },
        {
          "text": " ",
          "marks": [],
          "href": null
        },
        {
          "text": "かけるは内、のばすは外（太专业了= =，没想好怎么翻）",
          "marks": [],
          "href": null
        },
        {
          "text": " ",
          "marks": [],
          "href": null
        },
        {
          "text": "------------------------------------------------------------------------------------",
          "marks": [],
          "href": null
        },
        {
          "text": " ",
          "marks": [],
          "href": null
        },
        {
          "text": " ",
          "marks": [],
          "href": null
        },
        {
          "text": "比如124索这样的形，",
          "marks": [],
          "href": null
        },
        {
          "text": " ",
          "marks": [],
          "href": null
        },
        {
          "text": "摸到5索，从两面的角度考虑切掉1索是理所当然的打法。",
          "marks": [],
          "href": null
        },
        {
          "text": " ",
          "marks": [],
          "href": null
        },
        {
          "text": "但是，要立直的话就不一样了。",
          "marks": [],
          "href": null
        },
        {
          "text": " ",
          "marks": [],
          "href": null
        }
      ]
    },
