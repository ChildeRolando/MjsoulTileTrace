      {
        "type": "text",
        "sourceBlockIds": [
          "79-bilibili-cn:cv1793434:b0039"
        ],
        "sourceText": "理论：",
        "text": "理论：",
        "paragraphId": "79-bilibili-cn:cv1793434:p0039",
        "sourceSegments": [
          {
            "text": "理论：",
            "marks": [],
