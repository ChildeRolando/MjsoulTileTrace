          },
          {
            "text": " ",
            "marks": [],
            "href": null
          },
          {
            "text": "从安全度高地牌开始切。",
            "marks": [
              "strong:background:;color:#004e80;:"
            ],
            "href": null
          },
          {
            "text": " ",
