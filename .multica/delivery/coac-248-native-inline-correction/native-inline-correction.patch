-export function checkNativePdfInlineContent(candidate,page,plan=null,raw=null){
- if(candidate.provenance?.flowMode!==nativePdfFlowMode||candidate.body.flowOrder!=='model-inline-source-regions')throw Error('audit_native_pdf_flow_mode');
- const source=new Map(page.blocks.filter(b=>b.type==='text').map(b=>[b.id,b.lines.map(l=>l.text).join('')])),figures=new Map(candidate.figures.map(f=>[f.figureId,f])),used=[],flow=candidate.body.blocks,rawFlow=[];
