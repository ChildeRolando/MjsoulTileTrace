      "blocks": [
        {
          "type": "h2",
          "id": "modern-yabejp-ja-chapter03-section003-b1",
          "page": null,
          "locator": {
            "url": "http://yabejp.web.fc2.com/mahjong/tactics/chapter03/section003.html",
            "sourceBlockIds": [
