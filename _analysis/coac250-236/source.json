  "blocks": [
    {
      "id": "modern-yabejp-ja:chapter04-section015:b0001",
      "paragraphId": "modern-yabejp-ja:chapter04-section015:p0001",
      "tag": "h2",
      "domPath": "main/h2[3]",
      "tableContext": null,
      "type": "text",
      "text": "飛び寸前の局面",
      "segments": [
        {
          "text": "飛び寸前の局面",
          "marks": [],
