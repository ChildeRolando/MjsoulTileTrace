                "79-bilibili-cn:cv1760573:b0012"
              ],
              "domPaths": [
                "main/div[11]/div[0]/div[0]/div[0]/div[0]"
              ]
            },
            "caption": "舍牌示例，末张1m横置。",
            "imageSha256": "6626bccacf4c1491bb3cd973590fe930d754ad139cbc2aa88cd5eb177c73bf16",
            "imageProvenance": {
