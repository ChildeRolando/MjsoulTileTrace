            {
              "text": " ",
              "marks": [],
              "href": null
            },
            {
              "text": "立直理论2：",
              "marks": [],
              "href": null
            },
            {
              "text": " ",
              "marks": [],
              "href": null
            },
            {
              "text": " ",
              "marks": [],
