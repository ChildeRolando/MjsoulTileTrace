      "tag": "h3",
      "domPath": "main/h3[7]",
      "tableContext": null,
      "type": "text",
      "text": "ドラ切りリーチ（ダマや仕掛けてのテンパイも含む）",
      "segments": [
        {
          "text": "ドラ切りリーチ（ダマや仕掛けてのテンパイも含む）",
          "marks": [],
          "href": null
        }
