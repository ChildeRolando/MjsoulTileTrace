 const checklist=frame.contract.pages.map((p,i)=>({page:p.page,canonical:p.canonical,candidate:p.derivative,
  originalAStatus:result.originalAStatus,originalAModelFlags:result.originalAModelFlags,
  blocks:sources[i].blocks.map(block=>({sourceBlockId:block.id,type:block.type,
   body:frame.derivatives[i].body.blocks.flatMap((b,n)=>(b.sourceBlockIds??[]).includes(block.id)?[{index:n,id:b.id,type:b.type}]:[]),
   figures:frame.derivatives[i].figures.flatMap((f,n)=>(f.sourceImageBlockIds??[]).includes(block.id)?[{index:n,id:f.figureId,unknowns:f.unknowns}]:[])})),
  mandatoryLimits:result.mandatoryLimits,actualMcpArenaReadbackComplete:false,covered:false}));
 await writeFile(resolve(here,'verification.json'),JSON.stringify(result,null,2)+'\n');
 await writeFile(resolve(here,'page-readback-checklist.json'),JSON.stringify(checklist,null,2)+'\n');
 console.log(JSON.stringify({status:result.status,boundFiles:result.boundFileCount,exactFields:result.exactFieldCount,sourceBlocks:checklist.reduce((n,p)=>n+p.blocks.length,0),newModelCalls:0,admissionGranted:false}));
