const immutable=new Map();
async function bound(path,expected,copy){
 const b=await readFile(path),sha256=hash(b);if(expected&&sha256!==expected)throw Error('changed_input:'+path);
 immutable.set(path,sha256);
 if(copy){await mkdir(dirname(join(out,copy)),{recursive:true});await writeFile(join(out,copy),b);}
 return {path,sha256,bytes:b.length,...(copy?{packagePath:copy}:{})};
}
function pointer(obj,path){let node=obj;const parts=path.slice(1).split('/').map(x=>x.replaceAll('~1','/').replaceAll('~0','~'));const key=parts.pop();for(const part of parts)node=node[part];if(!Object.hasOwn(node,key))throw Error('missing_pointer:'+path);return {node,key};}
function diff(a,b,path=''){
 if(isDeepStrictEqual(a,b))return [];
 if(a&&b&&typeof a==='object'&&typeof b==='object'&&Array.isArray(a)===Array.isArray(b)){
  if(Array.isArray(a)&&a.length!==b.length)return [path];
  const keys=new Set([...Object.keys(a),...Object.keys(b)]);return [...keys].flatMap(k=>diff(a[k],b[k],path+'/'+k));
 }
 return [path];
}

