                    'independentSummary': review['summary'], 'independentFlow': review['flowCheck'],
                    'oldIssues': review['issues'], 'neighboringContext': audit['neighboringContext'],
                    'status': 'existing-needs-repair-no-new-verdict'}
        write(f'pages/page-{n:04d}.json', evidence)
        evidence_pages[n] = evidence
        page_rows.append({'page': n, 'chapterId': row['chapterId'], 'sourceBlockCount': len(source['blocks']),
                          'mappedSourceBlockCount': len(mapping), 'missingSourceBlockIds': [],
                          'textChecks': dict(collections.Counter(b['verdict'] for b in review['bodyChecks'])),
                          'figureChecks': dict(collections.Counter(b['verdict'] for b in review['figureChecks'])),
                          'sourceImageBlocks': len(image_checks), 'candidateFigures': len(figure_checks),
                          'source': sb, 'candidate': cb, 'audit': ab,
                          'producerRaw': maker_raw, 'reviewerRaw': audit_raws,
                          'stillNotPassed': review['issues'], 'detail': f'pages/page-{n:04d}.json',
                          'scopedDisplayEvidence': f'limited-admission.json:p{n}',
                          'pageAcceptanceChanged': False})
        scoped.append({'page': n, 'bodySourceIdsWithExistingFaithfulCheck': [b['id'] for b in review['bodyChecks'] if b['verdict'] == 'faithful'],
                       'bodySourceIdsStillHeld': nonfaithful_body,
                       'figureIdsWithExistingFaithfulCheck': [f['id'] for f in review['figureChecks'] if f['verdict'] == 'faithful'],
                       'figuresWithUnknownsHeldAsSourceNotesPendingScopeAdjudication': targets,
                       'independentEvidence': {'audit': ab, 'summary': review['summary'], 'flow': review['flowCheck']},
                       'proposal': 'Retain all clear text including TOC/research descriptions, author reviews and bibliography in original reading flow; show original covers with precise existing unknown notes. No cover detail may supply tactical tile facts or guessed publication/name text.',
                       'currentGateStatus': audit['status'], 'autoAdmission': False,
                       'needsIndependentScopeRuling': uncertain_ids,
                       'notAllowed': ['whole-page passed substitution', 'relabel all prose as navigation', 'delete TOC/preface from completion denominator', 'erase unknowns', 'guess cover text or tile codes']})
        source_bindings.extend([sb, cb, ab, maker_raw, *audit_raws, full_page, flow])

