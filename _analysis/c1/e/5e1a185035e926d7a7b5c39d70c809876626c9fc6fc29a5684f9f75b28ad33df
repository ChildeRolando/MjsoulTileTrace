            mapping.append({'sourceBlockId': bid, 'sourceType': block['type'], 'bbox': block.get('bbox'),
                            'sourceText': '\n'.join(line['text'] for line in block.get('lines', [])),
                            'sourceImageSha256': block.get('imageSha256'), 'candidateBody': body_refs,
                            'candidateFigures': figure_refs,
                            'independentCheck': text_checks.get(bid) if block['type'] == 'text' else image_checks[bid]})
        uncertain_ids = [f['id'] for f in review['figureChecks'] if f['verdict'] == 'uncertain']
