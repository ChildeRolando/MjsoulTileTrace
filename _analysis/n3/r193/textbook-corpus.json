              "79-bilibili-cn:cv1765377:b0022"
            ],
            "domPaths": [
              "main/div[22]/div[0]/div[0]/div[0]/div[0]"
            ]
          },
          "figure": {
            "figureId": "79-bilibili-cn-cv1765377-b22",
            "unitId": "79-bilibili-cn-cv1765377-argument",
            "page": null,
            "locator": {
              "url": "https://www.bilibili.com/read/cv1765377",
              "sourceBlockIds": [
                "79-bilibili-cn:cv1765377:b0022"
              ],
              "domPaths": [
                "main/div[22]/div[0]/div[0]/div[0]/div[0]"
              ]
            },
            "caption": "六种基本两面搭子及其听牌。",
            "imageSha256": "48d8d2e5b545c2d9658b66383b3bd6434237b486e92ed93ad0edd14785e89606",
            "imageProvenance": {
              "kind": "derived-source-assets",
              "method": "source-order-horizontal-RGBA-bottom-aligned-no-gap",
              "sourceAssetSha256s": [
                "1139fe45c9e86dd112dc39c6039be6c195765432a7f652f2945aa37d422f4213"
              ]
            },
            "transcription": {
              "text": "自上而下共六行，每行左侧为搭子，右侧红字为对应听牌：\n第1行：2m 3m；右侧标签：听1m、4m。\n第2行：3m 4m；右侧标签：听2m、5m。\n第3行：4m 5m；右侧标签：听3m、6m。\n第4行：5m 6m；右侧标签：听4m、7m。\n第5行：6m 7m；右侧标签：听5m、8m。\n第6行：7m 8m；右侧标签：听6m、9m。"
            },
            "requiresImageForFullExample": false
          }
        },
        {
          "type": "p",
          "id": "79-bilibili-cn-cv1765377-b23",
          "page": null,
          "locator": {
            "url": "https://www.bilibili.com/read/cv1765377",
            "sourceBlockIds": [
              "79-bilibili-cn:cv1765377:b0023"
            ],
            "domPaths": [
              "main/p[23]"
            ]
          },
          "text": "以上六组就是两面听牌的所有形。这六组需要全部记住。"
        },
        {
          "type": "p",
          "id": "79-bilibili-cn-cv1765377-b24",
          "page": null,
          "locator": {
            "url": "https://www.bilibili.com/read/cv1765377",
            "sourceBlockIds": [
              "79-bilibili-cn:cv1765377:b0024"
            ],
            "domPaths": [
              "main/p[24]"
            ]
          },
          "text": "要记住这六组应该是非常容易的。"
        },
        {
          "type": "p",
          "id": "79-bilibili-cn-cv1765377-b25",
          "page": null,
          "locator": {
            "url": "https://www.bilibili.com/read/cv1765377",
            "sourceBlockIds": [
              "79-bilibili-cn:cv1765377:b0025"
            ],
            "domPaths": [
              "main/p[25]"
            ]
          },
          "text": "------------------------------------------------------------------------------------"
        },
        {
          "type": "p",
          "id": "79-bilibili-cn-cv1765377-b26",
          "page": null,
          "locator": {
            "url": "https://www.bilibili.com/read/cv1765377",
            "sourceBlockIds": [
              "79-bilibili-cn:cv1765377:b0026"
            ],
            "domPaths": [
              "main/p[26]"
            ]
          },
          "text": "3条筋"
        },
        {
          "type": "p",
          "id": "79-bilibili-cn-cv1765377-b27",
          "page": null,
          "locator": {
            "url": "https://www.bilibili.com/read/cv1765377",
            "sourceBlockIds": [
              "79-bilibili-cn:cv1765377:b0027"
            ],
            "domPaths": [
              "main/p[27]"
            ]
          },
          "text": "------------------------------------------------------------------------------------"
        },
        {
          "type": "p",
          "id": "79-bilibili-cn-cv1765377-b28",
          "page": null,
          "locator": {
            "url": "https://www.bilibili.com/read/cv1765377",
            "sourceBlockIds": [
              "79-bilibili-cn:cv1765377:b0028"
            ],
            "domPaths": [
              "main/p[28]"
            ]
          },
          "text": "看了上面的六组听牌，"
        },
        {
          "type": "p",
          "id": "79-bilibili-cn-cv1765377-b29",
          "page": null,
          "locator": {
            "url": "https://www.bilibili.com/read/cv1765377",
            "sourceBlockIds": [
              "79-bilibili-cn:cv1765377:b0029"
            ],
            "domPaths": [
              "main/p[29]"
            ]
          },
          "text": "我们可以发现，1-4与4-7、2-5与5-8、3-6与6-9之间有相连的地方。"
        },
        {
          "type": "p",
          "id": "79-bilibili-cn-cv1765377-b30",
          "page": null,
          "locator": {
            "url": "https://www.bilibili.com/read/cv1765377",
            "sourceBlockIds": [
              "79-bilibili-cn:cv1765377:b0030"
            ],
            "domPaths": [
              "main/p[30]"
            ]
          },
          "text": "这样就可以推导出三面张的筋。"
        },
        {
          "type": "figure",
          "id": "79-bilibili-cn-cv1765377-b31",
          "page": null,
          "locator": {
            "url": "https://www.bilibili.com/read/cv1765377",
