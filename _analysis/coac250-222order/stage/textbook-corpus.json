                "79-bilibili-cn:cv1775262:b0014"
              ],
              "domPaths": [
                "main/div[13]/div[0]/div[0]/div[0]/div[0]"
              ]
            },
            "caption": "例3的舍牌及三处向下箭头。",
            "imageSha256": "d656a8c69cdfc1c07020d935dea22910f16bb41c608bd2398e49dbbf5057f219",
            "imageProvenance": {
              "kind": "derived-source-assets",
              "method": "source-order-horizontal-RGBA-bottom-aligned-no-gap",
              "sourceAssetSha256s": [
                "59af3ba21e62d26a37e577da8b4b1e1cbc19436382f44998231cceefb6fcc7ed"
              ]
            },
            "transcription": {
              "text": "左上方标签：例3。牌序从左至右：4z 3z 7z 2z 1s 2m 7m 2m 8p 9p 8s；第11张8s横置。\n三支向下箭头分别位于第4张2z、第5张1s、第8张2m的正上方。"
            },
            "requiresImageForFullExample": false
          }
        },
        {
          "type": "p",
          "id": "79-bilibili-cn-cv1775262-b15",
          "page": null,
          "locator": {
            "url": "https://www.bilibili.com/read/cv1775262",
            "sourceBlockIds": [
              "79-bilibili-cn:cv1775262:b0015"
            ],
            "domPaths": [
              "main/p[14]"
            ]
          },
          "text": "（之后是摸切） 序盘是字牌的连切，所以第七巡的7万可以说是切的比较早的了。 而且2万也被切过，这里36万是万子的本线。 饼子和索子这里没有什么判断的材料，只能够认为所有的饼子和索子都是危险的。  实际的手牌如下： "
        },
        {
          "type": "figure",
          "id": "79-bilibili-cn-cv1775262-b16",
          "page": null,
          "locator": {
            "url": "https://www.bilibili.com/read/cv1775262",
            "sourceBlockIds": [
              "79-bilibili-cn:cv1775262:b0016"
            ],
            "domPaths": [
              "main/div[15]/div[0]/div[0]/div[0]/div[0]"
            ]
          },
          "figure": {
            "figureId": "79-bilibili-cn-cv1775262-b16",
            "unitId": "79-bilibili-cn-cv1775262-argument",
            "page": null,
            "locator": {
              "url": "https://www.bilibili.com/read/cv1775262",
              "sourceBlockIds": [
                "79-bilibili-cn:cv1775262:b0016"
              ],
              "domPaths": [
                "main/div[15]/div[0]/div[0]/div[0]/div[0]"
              ]
            },
            "caption": "例3的实际手牌与例4的舍牌。",
            "imageSha256": "2893976db50ecab99b2cb96f64505e46fc4ab25d43f48e2f7bdafc4fcdc91c50",
            "imageProvenance": {
              "kind": "derived-source-assets",
              "method": "source-order-horizontal-RGBA-bottom-aligned-no-gap",
              "sourceAssetSha256s": [
                "1d4a1109c991fc03b9c976afd918376feb2e9b497de0f63a57cc4313c02cb63f"
              ]
            },
            "transcription": {
              "text": "上排手牌从左至右：4m 4m 5m 5m 6m 1p 2p 3p 4p 5p 6p 7s 7s。\n下排左上方标签：例4。下排牌序从左至右：4z 3z 7z 2z 1p 9m 1m 4s 2s 9s 3z 6p；第12张6p横置。\n下排四支向下箭头分别位于第4张2z、第5张1p、第10张9s、第11张3z的正上方。"
            },
            "requiresImageForFullExample": false
          }
        },
        {
          "type": "p",
          "id": "79-bilibili-cn-cv1775262-b17",
          "page": null,
          "locator": {
            "url": "https://www.bilibili.com/read/cv1775262",
            "sourceBlockIds": [
              "79-bilibili-cn:cv1775262:b0017"
            ],
            "domPaths": [
              "main/p[16]"
            ]
          },
          "text": "（之后是摸切）  有一个常常被误解的东西，这里需要事先说明以下。 例4中58索是间四间的危险牌， 但是终盘切出的6饼并不能说明25饼是危险的。  如果是单纯的346饼的话，6饼应该被更早切出。 间四间确实是危险的， 但是不能正确掌握间四间的条件也是毫无意义的。  ------------------------------------------------------------------------------------ 被拆掉的两面搭子的里筋 ------------------------------------------------------------------------------------ 这是由“二度进张不利”的牌理反过来推导的逻辑。 "
        },
        {
          "type": "figure",
          "id": "79-bilibili-cn-cv1775262-b18",
          "page": null,
          "locator": {
            "url": "https://www.bilibili.com/read/cv1775262",
            "sourceBlockIds": [
              "79-bilibili-cn:cv1775262:b0018"
            ],
            "domPaths": [
              "main/div[17]/div[0]/div[0]/div[0]/div[0]"
            ]
          },
          "figure": {
            "figureId": "79-bilibili-cn-cv1775262-b18",
            "unitId": "79-bilibili-cn-cv1775262-argument",
            "page": null,
            "locator": {
              "url": "https://www.bilibili.com/read/cv1775262",
              "sourceBlockIds": [
                "79-bilibili-cn:cv1775262:b0018"
              ],
              "domPaths": [
                "main/div[17]/div[0]/div[0]/div[0]/div[0]"
              ]
            },
            "caption": "例5：带两支向下箭头的舍牌示例。",
            "imageSha256": "4a6639cfdae4cfa47a4583b2991965cf53555b34631bca6e720981a59cb5bac9",
            "imageProvenance": {
              "kind": "derived-source-assets",
              "method": "source-order-horizontal-RGBA-bottom-aligned-no-gap",
              "sourceAssetSha256s": [
                "d2274e920d3d4ce0bf95992da486067edfb14c13ccd227529a050faa0542e7cf"
              ]
            },
            "transcription": {
              "text": "左上方标签：例5。牌序从左至右：2z 3z 6z 8m 5m 1m 4z 3p 2p，共9张；第9张2p横置，无赤牌。\n两支向下箭头分别位于第6张1m、第7张4z的正上方。"
            },
            "requiresImageForFullExample": false
          }
        },
        {
          "type": "p",
          "id": "79-bilibili-cn-cv1775262-b19",
          "page": null,
          "locator": {
            "url": "https://www.bilibili.com/read/cv1775262",
            "sourceBlockIds": [
              "79-bilibili-cn:cv1775262:b0019"
            ],
            "domPaths": [
              "main/p[18]"
            ]
          },
          "text": "（之后摸切）  例5的立直很显眼的地方就是拆掉了23饼的两面搭子。 “正是因为拆掉了，所以才不会是14饼听牌啊”，这样的想法只是初学者的天真想法…… 实际上14饼才是关键啊，不是吗？ "
        },
        {
          "type": "figure",
          "id": "79-bilibili-cn-cv1775262-b20",
          "page": null,
          "locator": {
            "url": "https://www.bilibili.com/read/cv1775262",
            "sourceBlockIds": [
              "79-bilibili-cn:cv1775262:b0020"
            ],
            "domPaths": [
              "main/div[19]/div[0]/div[0]/div[0]/div[0]"
            ]
          },
          "figure": {
            "figureId": "79-bilibili-cn-cv1775262-b20",
            "unitId": "79-bilibili-cn-cv1775262-argument",
            "page": null,
            "locator": {
              "url": "https://www.bilibili.com/read/cv1775262",
              "sourceBlockIds": [
                "79-bilibili-cn:cv1775262:b0020"
              ],
              "domPaths": [
                "main/div[19]/div[0]/div[0]/div[0]/div[0]"
              ]
            },
            "caption": "假设A、B的手牌与各自右侧单列的牌。",
            "imageSha256": "e4c9391e311a60c1394bf76b9e696f4a9d7620e6edee002a7c41d069ec697738",
            "imageProvenance": {
              "kind": "derived-source-assets",
              "method": "source-order-horizontal-RGBA-bottom-aligned-no-gap",
              "sourceAssetSha256s": [
                "acff5a27e07328adb3584d0f39c4c4e7e05e57a69363edc18b900f144d9369c5"
              ]
            },
            "transcription": {
              "text": "上排左侧标签：假设A。连续排列的13张牌从左至右：2p 2p 3p 3p 7p 8p 7s 8s 8s 8s 7z 7z 7z；右侧间隔后另列1张9s。\n下排左侧标签：假设B。连续排列的13张牌从左至右：2p 3p 5p（赤牌） 6p 3s 4s 5s 5s 7s 8s 7z 7z 7z；右侧间隔后另列1张5s。"
            },
            "requiresImageForFullExample": false
          }
        },
        {
          "type": "p",
          "id": "79-bilibili-cn-cv1775262-b21",
          "page": null,
          "locator": {
            "url": "https://www.bilibili.com/read/cv1775262",
            "sourceBlockIds": [
              "79-bilibili-cn:cv1775262:b0021"
            ],
            "domPaths": [
              "main/p[20]"
            ]
          },
          "text": "想象一下A和B的两种牌型吧。  正是想避免二度进张，所以才拆掉了23饼的搭子。 留下了146饼听牌的可能性。 这种拆掉两面搭子的立直，一定要对其筋保持警惕。  总结、理论： 拆掉两面搭子的立直，要小心其二度进张。  ------------------------------------------------------------------------------------ 拆掉嵌张搭子的立直的跨筋 ------------------------------------------------------------------------------------  这种情况的条件比较复杂，但也是危险度非常高的情况。 从外→内拆掉嵌张搭子的立直，跨筋是危险的。 用文字说明有点难懂，我们来看看实际的例子吧。 "
        },
        {
          "type": "figure",
          "id": "79-bilibili-cn-cv1775262-b22",
          "page": null,
          "locator": {
            "url": "https://www.bilibili.com/read/cv1775262",
            "sourceBlockIds": [
              "79-bilibili-cn:cv1775262:b0022"
            ],
            "domPaths": [
              "main/div[21]/div[0]/div[0]/div[0]/div[0]"
            ]
          },
          "figure": {
            "figureId": "79-bilibili-cn-cv1775262-b22",
            "unitId": "79-bilibili-cn-cv1775262-argument",
            "page": null,
            "locator": {
              "url": "https://www.bilibili.com/read/cv1775262",
              "sourceBlockIds": [
                "79-bilibili-cn:cv1775262:b0022"
              ],
              "domPaths": [
                "main/div[21]/div[0]/div[0]/div[0]/div[0]"
              ]
            },
            "caption": "例6的舍牌及三处向下箭头。",
            "imageSha256": "763fcb2bcd82f0c22846158652bb1e89bd205ff0411cac7c665d0da5a1a24fcc",
            "imageProvenance": {
              "kind": "derived-source-assets",
              "method": "source-order-horizontal-RGBA-bottom-aligned-no-gap",
              "sourceAssetSha256s": [
                "6623913226656c52598bae069f6ec63566ca68500f34f01e83fd988eb25b997b"
              ]
            },
            "transcription": {
              "text": "左上方标签：例6。牌序从左至右：1z 5z 3z 9s 7p 1m 5s 1z 3m；第9张3m横置。\n三支向下箭头分别位于第3张3z、第4张9s、第8张1z的正上方。"
            },
            "requiresImageForFullExample": false
          }
        },
        {
          "type": "p",
          "id": "79-bilibili-cn-cv1775262-b23",
          "page": null,
          "locator": {
            "url": "https://www.bilibili.com/read/cv1775262",
            "sourceBlockIds": [
              "79-bilibili-cn:cv1775262:b0023"
            ],
            "domPaths": [
              "main/p[22]"
            ]
          },
          "text": "（之后摸切）  一眼看去没什么特征的舍牌，虽然无筋的牌都狠危险。 但是有一组危险等级更高的筋。  那就是25万。下面来说明理由。 这个立直拆掉了13万的嵌张搭子。 但是中间切掉了5索和东，所以不是单纯的拆掉嵌张搭子。 没有留下安全牌东，是因为手牌的需要。 也不像是摸到4万形成两面，因为要做两面的话，5索要优秀一些。 也就是说，从334万这种形里切出3万的可能性是很高的。  这种情况要是条件没有齐，或者是远离立直宣言牌拆掉的嵌张搭子，跨筋也不是那么危险的。  对立直危险牌的读牌这样的程度已经足够了， 更重要的还是下一节的“安全的情况”。     （待续）"
        }
      ]
    }
  ],
